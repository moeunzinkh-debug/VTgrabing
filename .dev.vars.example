# Local development overrides for `wrangler dev`.
# This file is git-ignored: copy `.dev.vars.example` and fill in your own values.
ENVIRONMENT=development
MOCK_ENABLED=true

# ---------------------------------------------------------------------------
# Real link grabber.
#   Analyze opens the URL you paste, finds every video source on the page
#   (and on the episode pages it links to), and the download provider streams
#   the real bytes into R2.
#
#   GRAB_ENABLED=false              only the mock catalog / mock downloader
#   GRAB_ALLOWED_HOSTS=a.com,b.com  restrict which hosts may be opened
#                                   (recommended for a public deployment)
#   GRAB_ALLOW_PRIVATE_HOSTS=true   also allow 127.0.0.1 / LAN targets, which is
#                                   what local fixture servers need. NEVER enable
#                                   this in production (SSRF), and it is ignored
#                                   when ENVIRONMENT=production.
#   GRAB_MAX_VIDEO_BYTES            hard cap per downloaded object
#   GRAB_CHUNK_BYTES                Range chunk = one R2 multipart part
# ---------------------------------------------------------------------------
GRAB_ENABLED=true
GRAB_ALLOWED_HOSTS=
GRAB_DENIED_HOSTS=
GRAB_ALLOW_PRIVATE_HOSTS=false
GRAB_MAX_VIDEOS=200
GRAB_MAX_VIDEO_BYTES=3221225472
GRAB_CHUNK_BYTES=8388608

# Optional, unofficial one-post TikTok provider. Keep off unless you accept that
# the TikTok URL is sent to SSSTik and you have the right to save the video.
# It never logs in, solves captchas, or bypasses DRM; enable only after local review.
TIKTOK_SSTIK_ENABLED=false
# Minimum spacing between two SSSTik requests (ms). Their backend rate-limits per
# IP (~10 s), and every episode needs a fresh single-use token, so series jobs are
# pinned to concurrency 1 regardless of DEFAULT_CONCURRENCY.
TIKTOK_SSTIK_MIN_INTERVAL_MS=1500
# Wait before the single in-provider retry of a rate-limited post (ssslimitexceed).
TIKTOK_SSTIK_COOLDOWN_SECONDS=12

# Authorized source (extractor) - leave empty to use the real link grabber.
SOURCE_API_BASE_URL=
SOURCE_API_TOKEN=
SOURCE_ALLOWED_HOSTS=

# Authorized download service - optional. When set it wins over the built-in
# `http-stream` provider for new jobs (pick a provider per job in the UI).
DOWNLOAD_SERVICE_URL=
DOWNLOAD_SERVICE_TOKEN=
DOWNLOAD_CALLBACK_SECRET=local-dev-callback-secret
DOWNLOAD_CALLBACK_URL=
PUBLIC_BASE_URL=http://localhost:8787
