{
  // Dedicated configuration used by `npm test` (@cloudflare/vitest-pool-workers).
  // It mirrors wrangler.jsonc bindings but intentionally omits the `assets`
  // directory so the test suite never depends on a client build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vtgrab-test",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vtgrab-db-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "vtgrab-files-test"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "JOB_QUEUE",
        "queue": "vtgrab-jobs-test"
      }
    ],
    "consumers": [
      {
        "queue": "vtgrab-jobs-test",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 3
      }
    ]
  },
  "vars": {
    "ENVIRONMENT": "test",
    "MOCK_ENABLED": "true",
    "MAX_ATTEMPTS": "3",
    "DEFAULT_QUALITY": "1080p",
    "DEFAULT_CONTAINER": "mp4",
    "DEFAULT_CONCURRENCY": "4",
    "FILE_URL_TTL_SECONDS": "3600",
    "QUEUE_PUSH_BATCH_SIZE": "100",
    "STALE_ITEM_MINUTES": "20",
    "SOURCE_ALLOWED_HOSTS": "",
    "PUBLIC_BASE_URL": "https://vtgrab.example.com",
    // The automated suite drives the deterministic mock pipeline; the real
    // grabber (network I/O) is covered in test/grab.test.ts with a stubbed fetch.
    "GRAB_ENABLED": "false",
    "TIKTOK_SSTIK_ENABLED": "false",
    // Keep the suite fast: both pacer settings default to 0 here. An explicit 0
    // is a real configuration for these two (see `num()` in src/env.ts), and the
    // non-zero behaviour is asserted directly in tiktok-ssstik.test.ts. Without
    // this, a rate-limit test would really sleep 12 s and every post would be
    // paced 1.5 s apart.
    "TIKTOK_SSTIK_MIN_INTERVAL_MS": "0",
    "TIKTOK_SSTIK_COOLDOWN_SECONDS": "0"
  }
}
