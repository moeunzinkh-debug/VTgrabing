# Copy to .dev.vars for `wrangler dev` (wrangler reads .dev.vars, not .env).
# Never commit real values. Production secrets: `npx wrangler secret put NAME`.
ENVIRONMENT=development
MOCK_ENABLED=true

# Authorized source (extractor) - leave empty to use the mock catalog.
SOURCE_API_BASE_URL=
SOURCE_API_TOKEN=
SOURCE_ALLOWED_HOSTS=

# Authorized download service - leave empty to use the mock downloader.
DOWNLOAD_SERVICE_URL=
DOWNLOAD_SERVICE_TOKEN=
DOWNLOAD_CALLBACK_SECRET=local-dev-callback-secret
DOWNLOAD_CALLBACK_URL=
PUBLIC_BASE_URL=http://localhost:8787
