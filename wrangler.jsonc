{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vtgrabing",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-25",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },

  // Static single page frontend built by `npm run build:client` (Vite) into ./dist
  // The Worker runs first and serves the Vite bundle from `env.ASSETS`, with an
  // explicit SPA fallback (see src/index.ts).
  //
  // ./dist is git-ignored, so it only exists after a build. Cloudflare Workers
  // Builds therefore needs a *build command* (`npm run build`) in front of the
  // deploy command, otherwise the deploy fails with:
  //   The directory specified by the "assets.directory" field ... does not exist
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  // Like the Recap-ai worker: no D1 / R2 / Queue bindings, so a GitHub push
  // deploys with nothing to create in the Cloudflare dashboard first.
  // API routes that need storage answer 503 until bindings are added back.

  "vars": {
    "ENVIRONMENT": "production",
    // The MockExtractor / MockDownloadProvider are local-development helpers only.
    // Keep this false in production.
    "MOCK_ENABLED": "false",
    "MAX_ATTEMPTS": "3",
    "DEFAULT_QUALITY": "1080p",
    "DEFAULT_CONTAINER": "mp4",
    "DEFAULT_CONCURRENCY": "4",
    "FILE_URL_TTL_SECONDS": "3600",
    "QUEUE_PUSH_BATCH_SIZE": "100",
    "STALE_ITEM_MINUTES": "20",
    "SOURCE_ALLOWED_HOSTS": "",
    "PUBLIC_BASE_URL": ""
  }
}
